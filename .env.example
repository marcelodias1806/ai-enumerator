DATABASE_URL=postgresql+psycopg://ai_enum:change-me@db:5432/ai_enum
REDIS_URL=redis://redis:6379/0
HTTP_TIMEOUT=15

# Authentication - change before deployment
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
JWT_TTL_MINUTES=480
AUTH_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# Generic policy-feed protection
FEED_TOKEN=change-this-feed-token

# Exposure scanner
EXPOSURE_HTTP_TIMEOUT=6
EXPOSURE_TCP_TIMEOUT=3
EXPOSURE_MAX_TARGETS=500
EXPOSURE_VERIFY_TLS=true
EXPOSURE_ALLOW_HTTP_GET=false
EXPOSURE_SCAN_CONCURRENCY=20
EXPOSURE_REDIRECT_LIMIT=5

# Scheduled assessment
EXPOSURE_AUTO_SCAN=true
EXPOSURE_AUTO_SCAN_INTERVAL_SECONDS=86400
ASSESSMENT_COMPANY_NAME=Organization
ASSESSMENT_REPORT_TITLE=AI Egress Exposure Assessment
